{
  "expo": {
    "name": "Lingopanda",
    "slug": "lingua",
    "owner": "languageappexpo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lingua",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lingua.mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Lingopanda benötigt Zugriff auf die Spracherkennung, um deine Sprachaufnahmen in Text umzuwandeln.",
        "NSMicrophoneUsageDescription": "Lingopanda benötigt Mikrofonzugriff, damit du Nachrichten im KI-Gespräch per Sprachaufnahme senden kannst."
      }
    },
    "android": {
      "package": "app.lingua.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#73030D"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lingopanda benötigt Mikrofonzugriff, damit du Nachrichten im KI-Gespräch per Sprachaufnahme senden kannst.",
          "speechRecognitionPermission": "Lingopanda benötigt Zugriff auf die Spracherkennung, um deine Sprachaufnahmen in Text umzuwandeln.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "backgroundColor": "#73030D",
          "imageResizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://lingua-backend-3q0z.onrender.com/api/v1",
      "eas": {
        "projectId": "4f675313-77f3-4c10-8990-8d5b739addd8"
      }
    }
  }
}
