# --- Datenbank -------------------------------------------------------------
DATABASE_URL="postgresql://lingua:lingua@localhost:5432/lingua?schema=public"
# Nur für gepoolte Verbindungen (z. B. Supabase Port 6543) relevant: dorthin
# geht die direkte Verbindung für Migrationen. Lokal identisch zu DATABASE_URL.
DIRECT_URL="postgresql://lingua:lingua@localhost:5432/lingua?schema=public"

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Auth ------------------------------------------------------------------
# In Produktion zwingend durch lange Zufallswerte ersetzen (z. B. openssl rand -hex 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- KI (Claude-Abo) -------------------------------------------------------
# Die KI läuft über die lokal installierte und angemeldete claude-CLI
# (Claude Code, z. B. Pro-Abo) – kein API-Key nötig. Liegt die CLI nicht im
# globalen npm-Verzeichnis, den Pfad zur claude(.exe) hier angeben:
# CLAUDE_CLI_PATH=
AI_MODEL=claude-opus-5
# Monatliches KI-Kontingent pro Konto – für alle gleich, rein als
# Missbrauchsschutz. Es gibt keine Bezahlstufe.
AI_MONTHLY_LIMIT=1000

# Sprachaufnahme im Chat (Alternative zum Tippen) – läuft über die
# OpenAI-Whisper-API, da Anthropic keine Audio-Transkription anbietet.
OPENAI_API_KEY=
# Sprachsynthese fuer die Mediathek (npm run media:tts)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=whisper-1

