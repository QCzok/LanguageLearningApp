# --- Datenbank -------------------------------------------------------------
DATABASE_URL="postgresql://lingua:lingua@localhost:5432/lingua?schema=public"
# Nur für gepoolte Verbindungen (z. B. Supabase Port 6543) relevant: dorthin
# geht die direkte Verbindung für Migrationen. Lokal identisch zu DATABASE_URL.
DIRECT_URL="postgresql://lingua:lingua@localhost:5432/lingua?schema=public"

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Auth ------------------------------------------------------------------
# In Produktion zwingend durch lange Zufallswerte ersetzen (z. B. openssl rand -hex 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- KI (Anthropic) --------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_FREE_MONTHLY_LIMIT=5
AI_PREMIUM_MONTHLY_LIMIT=1000
# "api" (Standard) nutzt ANTHROPIC_API_KEY oben. "subscription" nutzt
# stattdessen die lokal installierte claude-CLI (ein Claude-Abo auf diesem
# Rechner) – Entwicklungs-Übergangslösung, siehe ClaudeCliClient.
AI_PROVIDER=api

# Sprachaufnahme im Chat (Alternative zum Tippen) – läuft über die
# OpenAI-Whisper-API, da Anthropic keine Audio-Transkription anbietet.
OPENAI_API_KEY=
# Sprachsynthese fuer die Mediathek (npm run media:tts)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=whisper-1

