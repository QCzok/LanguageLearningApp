// Lingua – Datenmodell
// Konventionen: cuid()-IDs, UTC-Timestamps, @@map auf snake_case Tabellennamen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL zeigt auf den Connection-Pooler (Port 6543,
  // pgbouncer=true), DIRECT_URL auf die direkte Verbindung (Port 5432) –
  // Migrationen brauchen die direkte Verbindung, der Pooler unterstützt kein
  // Prepared-Statement-Verhalten, das `migrate deploy` benötigt.
  directUrl = env("DIRECT_URL")
}

// ============================================================ Enums

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum LevelSource {
  SELF_SELECTED
  PLACEMENT_TEST
}

enum CardStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum VocabMode {
  FLASHCARD
  MULTIPLE_CHOICE
  TYPING
  LISTENING
  MATCHING
  SPEAKING
  TRANSLATE
  SENTENCE_ORDER
  WORD_BUILD
}

enum LibraryType {
  ARTICLE
  STORY
}

enum ExerciseType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN
}

/// Wonach sich die Mediathek gliedert. Kein Format, sondern die Frage, was
/// einen beim Anschauen erwartet – danach sucht man, wenn man zwanzig Minuten
/// Zeit hat und nicht schon weiß, welches Video man will.
enum VideoTopic {
  EVERYDAY
  STREET_INTERVIEW
  GRAMMAR
  VOCABULARY
  CULTURE
}

enum AiMode {
  CHAT
  DISCUSSION
  GRAMMAR
  CORRECTION
}

enum AiFeature {
  NOTEBOOK_ANALYSIS
  CHAT
  GRAMMAR_EXPLANATION
  RECOMMENDATIONS
  VOCAB_GENERATION
  VOICE_TRANSCRIPTION
  TRANSLATION
}

enum PageBackground {
  BLANK
  LINED
  GRID
  DOTTED
}

/// Die vier Bücher des Lehrwerks: drei Kursbücher entlang des Könnens und
/// ein Grammatikbuch quer dazu (siehe WORKBOOK_BOOKS in @lingua/shared).
enum WorkbookBook {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  GRAMMAR
}

enum UnitStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ============================================================ Nutzer & Auth

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  displayName         String
  avatarUrl           String?
  /// Ausgewähltes Profil-Icon (siehe AVATAR_ICONS in @lingua/shared), z. B. "fox".
  avatarIcon          String?
  role                UserRole  @default(USER)
  plan                Plan      @default(FREE)
  premiumUntil        DateTime?
  /// Muttersprache als ISO-639-1 Code – steuert Übersetzungen und KI-Erklärungen.
  nativeLanguage      String    @default("de")
  xp                  Int       @default(0)
  streakDays          Int       @default(0)
  lastActivityDate    DateTime?
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  profiles          LearningProfile[]
  placementAttempts PlacementAttempt[]
  vocabProgress     VocabProgress[]
  reviewLogs        ReviewLog[]
  decks             VocabDeck[]
  notebooks         Notebook[]
  notebookAnalyses  NotebookAnalysis[]
  libraryAttempts   LibraryAttempt[]
  readingProgress   ReadingProgress[]
  videoProgress     VideoProgress[]
  aiConversations   AiConversation[]
  aiUsage           AiUsage[]
  dailyActivities   DailyActivity[]
  unitProgress      UnitProgress[]
  studyProgress     StudyLessonProgress[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nur der Hash wird gespeichert – ein DB-Leak gibt keine gültigen Tokens preis.
  tokenHash String
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================ Sprachen & Profil

model Language {
  id          String  @id @default(cuid())
  code        String  @unique // ISO-639-1, z. B. "en"
  name        String // deutscher Name, z. B. "Englisch"
  nativeName  String // "English"
  flagEmoji   String
  isActive    Boolean @default(true)
  // Nur wählbar als Lernsprache (eigener Kurs), wenn true. Sprachen ohne
  // Kursinhalt (Kapitel, Vokabelstapel, Einstufungstest) stehen trotzdem als
  // Muttersprache zur Wahl, siehe LanguagesService.findAll.
  isLearnable Boolean @default(true)
  sortOrder   Int     @default(0)

  profiles           LearningProfile[]
  placementQuestions PlacementQuestion[]
  placementAttempts  PlacementAttempt[]
  decks              VocabDeck[]
  libraryContents    LibraryContent[]
  videos             VideoItem[]
  notebooks          Notebook[]
  aiConversations    AiConversation[]
  chapters           Chapter[]

  @@map("languages")
}

model LearningProfile {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId       String
  language         Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level            CefrLevel
  levelSource      LevelSource @default(SELF_SELECTED)
  dailyGoalMinutes Int         @default(15)
  /// Genau ein Profil pro Nutzer ist aktiv; die App lernt in dieser Sprache.
  /// Erzwungen von einem partiellen Unique-Index (`userId WHERE isActive`),
  /// den Prisma im Schema nicht ausdrücken kann – er steht als reines SQL in
  /// der Migration `20260916150000_one_active_profile_per_user`. Wer hier
  /// `isActive` setzt, muss die anderen Profile des Nutzers in derselben
  /// Transaktion abschalten (siehe `UsersService.activateProfile`).
  isActive         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([userId, languageId])
  @@index([userId, isActive])
  @@map("learning_profiles")
}

// ============================================================ Einstufungstest

model PlacementQuestion {
  id           String    @id @default(cuid())
  languageId   String
  language     Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level        CefrLevel
  prompt       String
  helperText   String?
  options      String[]
  correctIndex Int
  points       Int       @default(1)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)

  @@index([languageId, level])
  @@map("placement_questions")
}

model PlacementAttempt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId   String
  language     Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  /// [{ questionId, selectedIndex, correct }]
  answers      Json
  correct      Int
  total        Int
  scorePercent Int
  resultLevel  CefrLevel
  createdAt    DateTime  @default(now())

  @@index([userId, languageId])
  @@map("placement_attempts")
}

// ============================================================ Vokabeltrainer

model VocabDeck {
  id          String    @id @default(cuid())
  languageId  String
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level       CefrLevel
  title       String
  /// Titel je Muttersprache (ISO-639-1 → Text). Systemdecks werden in allen
  /// Lernsprachen aus denselben Kategorien gebaut – wer Englisch mit
  /// spanischer Muttersprache lernt, liest die Kategorie auf Spanisch.
  /// Fehlt die Sprache, gilt `title`.
  titles      Json?
  /// Stabiler Schlüssel der Seed-Kategorie (z. B. "a1-food") – der Seed
  /// gleicht darüber ab, nicht über den Titel.
  seedKey     String?
  description String?
  iconEmoji   String    @default("📘")
  /// Systemdecks werden ausgeliefert, Nutzerdecks gehören ownerId.
  isSystem    Boolean   @default(true)
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items VocabItem[]

  @@unique([languageId, seedKey])
  @@index([languageId, level])
  @@index([ownerId])
  @@map("vocab_decks")
}

/// Übersetzungen für die Wortlisten aus Lehrwerk und Lektionen in
/// Muttersprachen, die der Inhalt selbst nicht mitbringt. Einmal per KI
/// erzeugt, gilt ein Eintrag für alle Lernenden (siehe VocabGlossService).
model VocabGloss {
  id           String   @id @default(cuid())
  /// Sprache des Begriffs (ISO-639-1), also die Kurssprache.
  termLanguage String
  term         String
  /// Vorhandene Übersetzung, die die gemeinte Bedeutung festlegt.
  sense        String
  /// Muttersprache, in die übersetzt wurde (ISO-639-1).
  language     String
  translation  String
  createdAt    DateTime @default(now())

  @@unique([termLanguage, term, sense, language])
  @@map("vocab_glosses")
}

model VocabItem {
  id                  String    @id @default(cuid())
  deckId              String
  deck                VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term                String
  /// Übersetzung für Muttersprachen ohne Eintrag in `translations` – bei
  /// eigenen Decks die Übersetzung in der Muttersprache des Besitzers.
  translation         String
  /// Übersetzungen je Muttersprache (ISO-639-1 → Text), z. B.
  /// { "de": "das Haus", "es": "la casa" }. Die API löst anhand der
  /// Muttersprache des Nutzers auf, Fallback ist `translation`.
  translations        Json      @default("{}")
  phonetic            String?
  partOfSpeech        String?
  exampleSentence     String?
  exampleTranslation  String?
  /// Übersetzungen des Beispielsatzes je Muttersprache (ISO-639-1 → Text),
  /// wie bei `translations`. Fallback ist `exampleTranslation`.
  exampleTranslations Json      @default("{}")
  audioUrl            String?
  imageUrl            String?
  tags                String[]
  sortOrder           Int       @default(0)

  progress   VocabProgress[]
  reviewLogs ReviewLog[]

  @@index([deckId])
  @@map("vocab_items")
}

/// SRS-Karte: Zustand einer Vokabel für genau einen Nutzer.
model VocabProgress {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabItemId    String
  vocabItem      VocabItem  @relation(fields: [vocabItemId], references: [id], onDelete: Cascade)
  status         CardStatus @default(NEW)
  easeFactor     Float      @default(2.5)
  intervalDays   Int        @default(0)
  repetitions    Int        @default(0)
  lapses         Int        @default(0)
  dueAt          DateTime   @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, vocabItemId])
  @@index([userId, dueAt])
  @@index([userId, status])
  @@map("vocab_progress")
}

model ReviewLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabItemId String
  vocabItem   VocabItem @relation(fields: [vocabItemId], references: [id], onDelete: Cascade)
  grade       Int
  correct     Boolean
  mode        VocabMode
  durationMs  Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("review_logs")
}

// ============================================================ Lernheft

model Notebook {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId String?
  language   Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)
  title      String
  coverColor String    @default("#2563EB")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pages NotebookPage[]

  @@index([userId, updatedAt])
  @@map("notebooks")
}

model NotebookPage {
  id           String         @id @default(cuid())
  notebookId   String
  notebook     Notebook       @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  index        Int
  background   PageBackground @default(LINED)
  /// NotebookPageContent aus @lingua/shared – versioniertes Element-Array.
  content      Json
  thumbnailUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  analyses NotebookAnalysis[]

  @@unique([notebookId, index])
  @@map("notebook_pages")
}

/// Ergebnis einer KI-Korrektur (Premium).
model NotebookAnalysis {
  id             String       @id @default(cuid())
  pageId         String
  page           NotebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recognizedText String
  summary        String
  scorePercent   Int
  /// [{ original, corrected, explanation, category, severity }]
  corrections    Json
  suggestions    String[]
  model          String
  createdAt      DateTime     @default(now())

  @@index([pageId, createdAt])
  @@map("notebook_analyses")
}

// ============================================================ Lehrwerk

/// Ein Kapitel eines Buchs. Die Kapitel laufen innerhalb des Buchs durch
/// (1 … n); `level` bleibt als GER-Angabe erhalten, ordnet aber nicht mehr.
model Chapter {
  id               String       @id @default(cuid())
  languageId       String
  language         Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)
  book             WorkbookBook
  level            CefrLevel
  order            Int
  title            String
  subtitle         String
  description      String
  coverEmoji       String       @default("📗")
  /// Kann-Beschreibungen im Sinne des GER.
  goals            String[]
  estimatedMinutes Int          @default(0)
  isPublished      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  units ChapterUnit[]

  @@unique([languageId, book, order])
  @@index([languageId, book])
  @@map("chapters")
}

/// Eine Seite eines Kapitels: Erklärung und die Aufgaben dazu in einem
/// Block-Array, in der Reihenfolge, in der man sie bearbeitet.
model ChapterUnit {
  id               String   @id @default(cuid())
  chapterId        String
  chapter          Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  subtitle         String?
  estimatedMinutes Int      @default(10)
  /// UnitContent aus @lingua/shared – versioniertes Block-Array inkl. Lösungen.
  content          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  progress UnitProgress[]

  @@unique([chapterId, order])
  @@index([chapterId])
  @@map("chapter_units")
}

/// Bearbeitungsstand einer Lerneinheit für genau einen Nutzer.
model UnitProgress {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId       String
  unit         ChapterUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status       UnitStatus  @default(NOT_STARTED)
  /// UnitAnswers – Antworten je Block-ID, überleben das Verlassen der Einheit.
  answers      Json        @default("{}")
  /// Freihand-Notizebene über den Blöcken (NotebookPageContent).
  annotations  Json?
  scorePercent Int?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, unitId])
  @@index([userId, status])
  @@map("unit_progress")
}

/// Stand einer Aufgabe in den Lektionen. Die Lektionen selbst liegen im Code
/// (`backend/src/modules/workbook/lessons`), daher ist `lessonId` ein Schlüssel
/// wie `de-a1-07` und kein Fremdschlüssel.
model StudyLessonProgress {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  blockId        String
  /// Bestes Ergebnis in Prozent.
  bestScore      Int
  /// Bisher mit dieser Aufgabe verdiente Punkte (siehe `studyPointsFor`).
  points         Int      @default(0)
  attempts       Int      @default(0)
  lastAnsweredAt DateTime @default(now())

  @@unique([userId, lessonId, blockId])
  @@index([userId])
  @@map("study_lesson_progress")
}

// ============================================================ Bibliothek

model LibraryContent {
  id               String      @id @default(cuid())
  languageId       String
  language         Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level            CefrLevel
  type             LibraryType
  title            String
  summary          String
  /// LibrarySection[] (siehe packages/shared) – Abschnitte mit optionaler
  /// Übersetzung und Glossar statt eines einzelnen Fließtext-Strings.
  body             Json
  author           String?
  imageUrl         String?
  wordCount        Int         @default(0)
  estimatedMinutes Int         @default(0)
  tags             String[]
  isPremium        Boolean     @default(false)
  publishedAt      DateTime    @default(now())

  exercises LibraryExercise[]
  attempts  LibraryAttempt[]
  progress  ReadingProgress[]

  @@index([languageId, level, type])
  @@map("library_contents")
}

model LibraryExercise {
  id           String         @id @default(cuid())
  contentId    String
  content      LibraryContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order        Int
  type         ExerciseType
  question     String
  options      String[]
  /// -1 bei offenen Fragen (Bewertung durch KI oder Selbstkontrolle).
  correctIndex Int            @default(-1)
  explanation  String?

  @@index([contentId, order])
  @@map("library_exercises")
}

model LibraryAttempt {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId    String
  content      LibraryContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  answers      Json
  score        Int
  total        Int
  scorePercent Int
  createdAt    DateTime       @default(now())

  @@index([userId, contentId])
  @@map("library_attempts")
}

model ReadingProgress {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId       String
  content         LibraryContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  progressPercent Int            @default(0)
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt

  @@unique([userId, contentId])
  @@map("reading_progress")
}

// ============================================================ Mediathek

/// Ein kuratiertes YouTube-Video.
///
/// Die Mediathek hostet nichts mehr selbst. Statt einer Handvoll eigener
/// Aufnahmen steht hier eine Auswahl fremder Videos – mehr Material, echte
/// Sprecher, und für jede Sprache und jedes Niveau etwas. Gespeichert wird
/// nur, was zum Finden und Einordnen nötig ist; Bild und Ton kommen beim
/// Abspielen von YouTube.
///
/// Der Datensatz ist erzeugt, nicht gepflegt: `npm run videos:refresh` zieht
/// ihn aus den Playlists der Quellkanäle (siehe seed/video-catalog.ts).
model VideoItem {
  id          String     @id @default(cuid())
  languageId  String
  language    Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level       CefrLevel
  topic       VideoTopic
  /// Die elfstellige YouTube-Kennung, aus der Einbettung und Vorschaubild
  /// gebildet werden. Eindeutig je Sprache, damit derselbe Beitrag nicht
  /// zweimal in derselben Mediathek steht.
  youtubeId   String
  title       String
  channelName String
  channelUrl  String
  durationSec Int
  /// Langsam und deutlich gesprochen – für Anfänger der wichtigste Filter.
  slowSpeech  Boolean    @default(false)
  tags        String[]
  isPremium   Boolean    @default(false)
  publishedAt DateTime   @default(now())

  progress VideoProgress[]

  @@unique([languageId, youtubeId])
  @@index([languageId, level, topic])
  @@map("video_items")
}

model VideoProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoItemId String
  videoItem   VideoItem @relation(fields: [videoItemId], references: [id], onDelete: Cascade)
  positionSec Int       @default(0)
  completed   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, videoItemId])
  @@map("video_progress")
}

// ============================================================ KI

model AiConversation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId String
  language   Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  mode       AiMode    @default(CHAT)
  level      CefrLevel
  title      String
  topic      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id              String         @id @default(cuid())
  conversationId  String
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String // "user" | "assistant"
  content         String
  /// Nur bei role = "user": "VOICE" (gesprochen) oder "TEXT" (getippt). Die
  /// Korrektur faellt je nach Quelle unterschiedlich streng aus – gesprochene
  /// Beitraege enthalten keine Zeichensetzung, die man bemaengeln koennte.
  source          String?
  /// Nur bei role = "user": der Beitrag in korrigierter Fassung, vollstaendig.
  /// null, wenn es nichts zu verbessern gab.
  correctedText   String?
  /// Kurze Begruendungen zur Korrektur, passend zu `correctedText`.
  correctionNotes String[]       @default([])
  createdAt       DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Verbrauchszähler für Kontingente und Kostenkontrolle.
model AiUsage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      AiFeature
  model        String
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  cachedTokens Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("ai_usage")
}

// ============================================================ Fortschritt

model DailyActivity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Auf Mitternacht UTC normalisiert.
  date           DateTime @db.Date
  minutes        Int      @default(0)
  xp             Int      @default(0)
  reviews        Int      @default(0)
  correctReviews Int      @default(0)
  readingCount   Int      @default(0)
  listeningCount Int      @default(0)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_activities")
}
